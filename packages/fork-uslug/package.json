{
  "name": "@joplin/fork-uslug",
  "version": "2.0.6",
  "description": "A permissive slug generator that works with unicode.",
  "author": "Jeremy Selier <jerem.selier@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest",
    "build": "yarn tsc",
    "tsc": "tsc --project tsconfig.json",
    "watch": "tsc --watch --preserveWatchOutput --project tsconfig.json"
  },
  "dependencies": {
    "node-emoji": "1.11.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "jest": "30.2.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/jeremys/uslug.git"
  },
  "main": "./index",
  "exports": {
    ".": "./index.js",
    "./lib/uslug": {
      "types": "./lib/uslug.ts",
      "require": "./lib/uslug.js",
      "default": "./lib/uslug.js"
    }
  },
  "engines": {
    "node": ">= 10.0.0"
  },
  "bugs": {
    "url": "http://github.com/jeremys/uslug/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "http://github.com/jeremys/uslug/raw/master/LICENSE"
    }
  ],
  "gitHead": "500e4c02809d3ebe463aa590e86f541d1ef0661c"
}
