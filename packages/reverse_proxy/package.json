{
  "name": "@joplin/reverse_proxy",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "tsc": "node node_modules/typescript/bin/tsc --project tsconfig.json",
    "build": "npm run tsc",
    "encrypt_https_server": "USE_HTTPS=true ENABLE_ENCRYPTION=true node --loader ts-node/esm src/index.ts",
    "encrypt_server": "ENABLE_ENCRYPTION=true node --loader ts-node/esm src/index.ts",
    "nonencrypt_server": "node --loader ts-node/esm src/index.ts",
    "start": "npm run encrypt_https_server",
    "dev": "npm run encrypt_server"
  },
  "dependencies": {
    "express": "^4.18.2",
    "follow-redirects": "^1.15.11",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "^18.16.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
