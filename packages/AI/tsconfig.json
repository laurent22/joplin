{
	"extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "declaration": true,
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
	"include": [
		"src"
	],
	"exclude": [
		"**/node_modules",
		"**/plugin_types",
	],
}

