{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "sync_cli (OneDrive)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "args": [
        "run",
        "sync_cli",
        "--",
        "--profileName",
        "joplin-desktop_test2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "MCP Server Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mcp:server",
        "--",
        "--profileName",
        "joplin_desktop_st"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "MCP_PORT": "8080"
      }
    },
    {
      "name": "MCP Server Direct (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": [
        "./mcp/server/index.ts",
        "--profileName",
        "joplin_desktop_st"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "MCP_PORT": "8080",
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Next: Dev (npm run dev)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--profileName",
        "joplin_desktop_test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std"
    },
    {
      "name": "Attach to Next (9229)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": null
    },
    {
      "name": "Launch Chrome to Debug Client",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--remote-debugging-port=9222"
      ]
    }
  ]
}
